# =============================================================================
# ASTRA VOICE — environment variables
# =============================================================================
#
# ITALIANO — come si usa questo file:
#   1. Copia questo file:  cp .env.example .env.local
#   2. Riempi SOLO le variabili marcate [LOCAL] per far partire il progetto sul tuo PC.
#   3. Le altre servono più avanti, milestone per milestone.
#   4. .env.local NON viene mai caricato su GitHub (è in .gitignore).
#   5. In produzione le chiavi si incollano in Netlify → Site settings → Environment variables.
#
#   ⚠️ NON incollare MAI una chiave vera in una chat, in uno screenshot o in un issue.
#      Se succede, quella chiave è da considerare compromessa: ruotala subito.
#
# LEGEND
#   [LOCAL] needed to run the app on your machine
#   [TEST]  needed to run the automated / integration tests
#   [PROD]  needed in production only
#   [M#]    the milestone from which this variable becomes required
#   PUBLIC  safe to expose in the browser (anything NEXT_PUBLIC_* is public — by design)
#   SECRET  server-only, never prefixed NEXT_PUBLIC_, never logged
#
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# PUBLIC · [LOCAL][PROD] · M1
# The canonical URL of the app. Used to build links inside SMS messages and
# invitation emails, and as the base URL for webhook registration.
# Local: http://localhost:3000   Production: your Netlify URL or custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# SUPABASE — database, authentication, storage
# Where to get these: https://supabase.com → create a free project →
#   Project Settings → API. Takes about 3 minutes.
# -----------------------------------------------------------------------------

# PUBLIC · [LOCAL][TEST][PROD] · M2
# "Project URL" on the API settings page. Looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC · [LOCAL][TEST][PROD] · M2
# The "anon / public" key. It is *designed* to be public: Row Level Security is
# what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET · [TEST][PROD] · M2
# The "service_role" key. This key BYPASSES Row Level Security completely.
# It is used only inside webhook handlers, voice-tool endpoints and cron jobs.
# It must never appear in a NEXT_PUBLIC_ variable, in the browser, or in a log.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET · [TEST] · M2
# Direct Postgres connection string, used only by the migration and seed scripts.
# Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=


# -----------------------------------------------------------------------------
# RETELL AI — the voice agent (speech recognition, conversation, speech synthesis)
# Where to get these: https://retellai.com → sign up → Dashboard → API Keys.
# Retell is a paid service billed per minute; keep a spending cap on the account.
# -----------------------------------------------------------------------------

# SECRET · [PROD] (and [TEST] for live-call testing) · M4
RETELL_API_KEY=

# SECRET · [TEST][PROD] · M4
# Signing secret for Retell webhooks. Every incoming webhook is rejected unless
# its signature verifies against this value. Retell Dashboard → Webhooks.
RETELL_WEBHOOK_SECRET=

# PUBLIC-ish · [PROD] · M4
# The id of the Retell agent this deployment syncs. Created automatically by the
# app on first sync; set it here to pin a specific agent.
RETELL_AGENT_ID=


# -----------------------------------------------------------------------------
# TWILIO — phone number and SMS
# Where to get these: https://twilio.com → Console dashboard (Account SID and
# Auth Token are on the front page). Buy an Irish local number under
# Phone Numbers → Buy a number. Note: Twilio requires regulatory address
# documentation for Irish numbers — allow a few days.
# -----------------------------------------------------------------------------

# SECRET · [PROD] · M4
TWILIO_ACCOUNT_SID=

# SECRET · [PROD] · M4
TWILIO_AUTH_TOKEN=

# SECRET · [PROD] · M5
# The number (E.164, e.g. +35315551234) or Messaging Service SID that sends the
# confirmation SMS. Must be SMS-capable — a voice-only number will not work.
TWILIO_MESSAGING_FROM=

# SECRET · [PROD] · M4
# Twilio's own webhook signature validation uses TWILIO_AUTH_TOKEN, so there is
# no separate secret. This variable pins the public URL Twilio was configured
# with, which is part of the signature calculation.
TWILIO_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# BOOKING PROVIDER
# V1 default is the built-in "internal" engine, which needs no credentials.
# Cal.com is optional and only needed if the restaurant uses it.
# Where to get it: https://cal.com → Settings → Developer → API keys.
# -----------------------------------------------------------------------------

# SECRET · optional · M5
CALCOM_API_KEY=

# optional · M5
CALCOM_EVENT_TYPE_ID=


# -----------------------------------------------------------------------------
# STRIPE — subscriptions (TEST MODE ONLY in V1)
# Where to get these: https://dashboard.stripe.com → toggle "Test mode" ON →
# Developers → API keys. Use the key starting with sk_test_.
# 🔴 Do not put a live key (sk_live_) anywhere in V1.
# -----------------------------------------------------------------------------

# SECRET · [PROD] · M7
STRIPE_SECRET_KEY=

# SECRET · [PROD] · M7
# Developers → Webhooks → your endpoint → Signing secret (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# PUBLIC · [PROD] · M7
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# OPERATIONS
# -----------------------------------------------------------------------------

# SECRET · [PROD] · M6
# A long random string you invent yourself. The scheduled data-retention job
# refuses to run unless the request carries this value, so nobody can trigger
# deletions from the internet.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=

# optional · [PROD] · M8
# Error monitoring DSN (Sentry or equivalent). Leave empty to disable.
SENTRY_DSN=
