# Public site URL — used by metadataBase, sitemap.ts, robots.ts and OG.
# Override per environment (preview / production).
NEXT_PUBLIC_SITE_URL="https://lumus.agency"

# Optional: where contact form submissions should be forwarded.
# When unset, /api/contact validates and logs to the server console.
# Wire to your transactional provider (Resend, Postmark, SendGrid, …) before launch.
CONTACT_RECIPIENT="hello@lumus.agency"
# RESEND_API_KEY=""
# POSTMARK_SERVER_TOKEN=""

# Optional: studio WhatsApp number (E.164, no leading "+") shown in the contact widget.
NEXT_PUBLIC_WHATSAPP_NUMBER="353871234567"
