}

.mb-opts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
@media (max-width: 700px) { .mb-opts { grid-template-columns: 1fr 1fr; } }
@media (max-width: 400px) { .mb-opts { grid-template-columns: 1fr; } }

.mb-opt {
  all: unset !important;
  display: flex !important;
  flex-direction: column !important;
  padding: 18px 16px !important;
  border: 1.5px solid rgba(16,44,51,0.09) !important;
  background: white !important;
  transition: border-color 0.3s ease, transform 0.3s var(--e1) !important;
  border-radius: 0 !important;
  position: relative !important;
  overflow: hidden !important;
}
.mb-opt::before {
  content: "" !important;
  position: absolute !important; inset: 0 !important;
  background: var(--navy) !important;
  transform: scaleX(0) !important;
  transform-origin: left !important;
  transition: transform 0.4s var(--e1) !important;
  z-index: 0 !important;
}
.mb-opt:hover::before { transform: scaleX(1) !important; }
.mb-opt:hover { transform: translateY(-2px) !important; }
.mb-opt-l, .mb-opt-s { position: relative !important; z-index: 1 !important; transition: color 0.3s ease !important; }
.mb-opt-l {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 12px; letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--navy); margin-bottom: 4px;
}
.mb-opt-s {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 9px; letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(16,44,51,0.35);
}
.mb-opt:hover .mb-opt-l,
.mb-opt:hover .mb-opt-s { color: white !important; }

.mb-result { animation: res-in 0.5s var(--e1) both; }
@keyframes res-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }

.mb-res-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: start;
}
@media (max-width: 600px) { .mb-res-row { grid-template-columns: 1fr; } }

.mb-eyebrow {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 9px; letter-spacing: 0.28em;
  text-transform: uppercase;
