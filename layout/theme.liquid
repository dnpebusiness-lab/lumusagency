}
.mb-res-desc {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 13px; line-height: 1.7;
  color: rgba(16,44,51,0.6);
  border-left: 2px solid var(--red);
  padding-left: 14px;
}
.mb-res-right { display: flex; flex-direction: column; gap: 20px; padding-top: 4px; }
.mb-meta-lbl {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 9px; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--grey);
  display: block; margin-bottom: 5px;
}
.mb-meta-val {
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 13px; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--navy);
}
.mb-bar { width: 100%; height: 1.5px; background: rgba(16,44,51,0.08); margin-top: 8px; position: relative; overflow: hidden; }
.mb-bar-fill { position: absolute; inset: 0 auto 0 0; background: var(--red); width: 0; transition: width 1.4s var(--e1); }
.mb-actions { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }

.mb-btn-primary {
  all: unset !important;
  display: block !important; text-align: center !important;
  padding: 14px 24px !important;
  background: var(--navy) !important; color: var(--cream) !important;
  font-family: "Helvetica Neue", Helvetica, sans-serif !important;
  font-size: 10px !important; letter-spacing: 0.22em !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
  position: relative !important; overflow: hidden !important;
  transition: color 0.4s var(--e1) !important;
}
.mb-btn-primary::before {
  content: "" !important; position: absolute !important; inset: 0 !important;
  background: var(--red) !important;
  transform: scaleX(0) !important; transform-origin: left !important;
  transition: transform 0.45s var(--e1) !important;
}
.mb-btn-primary:hover::before { transform: scaleX(1) !important; }
.mb-btn-primary > span { position: relative !important; z-index: 1 !important; }

.mb-btn-sec {
  all: unset !important; display: block !important;
  text-align: center !important; padding: 12px 24px !important;
  border: 1.5px solid rgba(16,44,51,0.12) !important;
  color: rgba(16,44,51,0.38) !important;
  font-family: "Helvetica Neue", Helvetica, sans-serif !important;
  font-size: 10px !important; letter-spacing: 0.22em !important;
  text-transform: uppercase !important;
  transition: all 0.3s ease !important;
}
.mb-btn-sec:hover { border-color: var(--navy) !important; color: var(--navy) !important; }
.mb-btn-sec::before { display: none !important; }

@media (max-width: 600px) {
  #mb-bar-inner { padding: 32px 20px 36px; }
}

/* ================================================================
   LOCATIONS PAGE
================================================================ */
.mb-loc-section { position: relative; overflow: hidden; }
.mb-loc-section .mb-parallax { will-change: transform; transition: none; }

.mb-loc-title { overflow: hidden; }
.mb-loc-title .mb-loc-inner {
  display: block;
  transform: translateY(100%);
  opacity: 0;
  transition: transform 1s cubic-bezier(0.16,1,0.3,1), opacity 0.8s ease;
}
.mb-loc-title.mb-loc-in .mb-loc-inner { transform: translateY(0); opacity: 1; }

.mb-loc-addr {
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.8s ease 0.25s, transform 0.8s cubic-bezier(0.16,1,0.3,1) 0.25s;
}
.mb-loc-addr.mb-loc-in { opacity: 1; transform: translateY(0); }

.mb-loc-line {
  display: block;
  height: 1px;
  background: rgba(255,255,255,0.5);
  width: 0;
  margin: 16px auto 0;
  transition: width 1s cubic-bezier(0.16,1,0.3,1) 0.3s;
}
.mb-loc-line.mb-loc-in { width: 120px; }

#mb-loc-counter {
  position: fixed;
  bottom: 32px; right: 32px;
  z-index: 500;
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  font-size: 10px; letter-spacing: 0.22em;
  color: rgba(16,44,51,0.35);
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}
#mb-loc-counter.show { opacity: 1; }
#mb-loc-counter span { color: var(--navy); }

.mb-loc-overlay {
  position: absolute; inset: 0;
  background: rgba(16,44,51,0.42);
  transition: background 0.6s ease;
  pointer-events: none; z-index: 1;
}
.mb-loc-section.mb-loc-active .mb-loc-overlay { background: rgba(16,44,51,0.28); }
.mb-loc-text { position: relative; z-index: 2; }

html, body { margin-top: 0 !important; padding-top: 0 !important; }
#mb-ticker, #mb-ticker-track {
  display: none !important; height: 0 !important; min-height: 0 !important;
  max-height: 0 !important; padding: 0 !important; margin: 0 !important; overflow: hidden !important;
}

</style>

<!-- Scroll Arrow -->
<div id="mb-arrow" aria-hidden="true">
  <div id="mb-arrow-line"></div>
  <div id="mb-arrow-dot"></div>
  <span id="mb-arrow-txt">Scroll</span>
</div>

<!-- Location Counter -->
<div id="mb-loc-counter" aria-hidden="true"><span>01</span> / 01</div>

<!-- Coffee Selector Bar -->
<div id="mb-bar" role="region" aria-label="Find your coffee">
  <div id="mb-bar-inner">
    <button id="mb-close-bar" aria-label="Close coffee selector" type="button">✕</button>
    <div id="mb-content"></div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var E = 'cubic-bezier(0.16,1,0.3,1)';

  /* ── Header scroll shadow ── */
  function initHeader() {
    var h = document.querySelector('.header-wrapper');
    if (!h) return;
    window.addEventListener('scroll', function () {
      h.classList.toggle('mb-scrolled', window.scrollY > 20);
    }, { passive: true });
  }

  /* ── Scroll Arrow ── */
  function initArrow() {
    var arrow = document.getElementById('mb-arrow');
    if (!arrow) return;
    setTimeout(function () {
      if (window.scrollY < 80) arrow.classList.add('show');
    }, 1400);
    window.addEventListener('scroll', function () {
      if (window.scrollY > 100) arrow.classList.remove('show');
      else arrow.classList.add('show');
    }, { passive: true });
    arrow.addEventListener('click', function () {
      var main = document.getElementById('MainContent');
      if (main) main.scrollIntoView({ behavior: 'smooth' });
    });
  }

  /* ── Scroll Reveal ── */
  function applyReveal() {
    [
      { s:'.card-wrapper',             v:'scale', st:true  },
      { s:'.collection-card',          v:'scale', st:true  },
      { s:'.multicolumn-card',         v:'up',    st:true  },
      { s:'.banner__content > *',      v:'up',    st:true  },
      { s:'.rich-text__wrapper',       v:'up',    st:false },
      { s:'.image-with-text__content', v:'up',    st:false },
      { s:'.image-with-text__media',   v:'fade',  st:false },
      { s:'.footer-block',             v:'up',    st:true  },
    ].forEach(function (r) {
      document.querySelectorAll(r.s).forEach(function (el, i) {
        if (el.closest('#mb-bar,#mb-ticker')) return;
        if (el.hasAttribute('data-mb')) return;
        el.setAttribute('data-mb', r.v);
        if (r.st && i > 0) el.style.transitionDelay = Math.min(i * 0.09, 0.45) + 's';
      });
    });
  }

  var rObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add('mb-in');
      rObs.unobserve(e.target);
    });
  }, { threshold: 0.07, rootMargin: '0px 0px -20px 0px' });

  function watchReveal() {
    document.querySelectorAll('[data-mb]').forEach(function (el) { rObs.observe(el); });
  }

  /* ── Text Split ── */
  function splitEl(el) {
    if (el.dataset.mbs) return;
    el.dataset.mbs = '1';
    var tw = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
    var ns = []; var n;
    while ((n = tw.nextNode())) { if (n.textContent.trim()) ns.push(n); }
    ns.forEach(function (tn) {
      var frag = document.createDocumentFragment();
      tn.textContent.split(/(\s+)/).forEach(function (w) {
        if (/^\s+$/.test(w)) {
          frag.appendChild(document.createTextNode(' '));
        } else if (w.trim()) {
          var o = document.createElement('span'); o.className = 'mb-word';
          var i = document.createElement('span'); i.className = 'mb-word-inner';
          i.textContent = w; o.appendChild(i); frag.appendChild(o);
        }
      });
      tn.parentNode.replaceChild(frag, tn);
    });
  }

  var tObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add('mb-split-in');
      e.target.querySelectorAll('.mb-word-inner').forEach(function (inn, i) {
        inn.style.transitionDelay = (i * 0.05) + 's';
      });
      tObs.unobserve(e.target);
    });
  }, { threshold: 0.2 });

  function initText() {
    document.querySelectorAll('h1,h2,h3,.banner__heading,.card__heading').forEach(function (el) {
      if (el.closest('#mb-bar,#mb-ticker')) return;
      if (el.querySelectorAll('*').length > 5) return;
      splitEl(el);
      tObs.observe(el);
    });
  }

  /* ── Hero sequence ── */
  function heroSeq() {
    document.querySelectorAll('.banner__content > *').forEach(function (el, i) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(18px)';
      el.style.transition = 'opacity 0.9s ' + E + ', transform 0.9s ' + E;
      el.style.transitionDelay = (0.18 + i * 0.13) + 's';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      });
    });
  }

  /* ── Magnetic buttons ── */
  function initMag() {
    document.querySelectorAll('.button,.btn').forEach(function (btn) {
      if (btn.closest('#mb-bar')) return;
      btn.addEventListener('mousemove', function (e) {
        var r = btn.getBoundingClientRect();
        btn.style.transform = 'translate(' +
          ((e.clientX - (r.left + r.width/2)) * 0.14) + 'px,' +
          ((e.clientY - (r.top  + r.height/2)) * 0.14) + 'px)';
      });
      btn.addEventListener('mouseleave', function () {
        btn.style.transition = 'transform 0.55s ' + E;
        btn.style.transform = '';
        setTimeout(function () { btn.style.transition = ''; }, 600);
      });
    });
  }

  /* ── Image fade ── */
  function initImgs() {
    document.querySelectorAll('img').forEach(function (img) {
      if (img.complete) return;
      img.style.opacity = '0';
      img.style.transition = 'opacity 0.6s ease';
      img.addEventListener('load', function () { img.style.opacity = '1'; }, { once:true });
    });
  }

  /* ================================================================
     COFFEE SELECTOR
  ================================================================ */
  var PRODS = [
    { name:'House Blend',            price:'From €11.80', url:'https://mochabeans.com/products/house-blend',                    desc:'The flagship blend. Balanced, chocolatey and full-bodied. Our most versatile coffee since 1997.', roast:'Medium-Dark', intensity:7 },
    { name:'Colombia Sierra Nevada',  price:'From €13.00', url:'https://mochabeans.com/products/colombia-medellin-washed',       desc:'Smooth and bright with milk chocolate and syrupy caramel. Perfect for filter brewing.',           roast:'Medium',      intensity:5 },
    { name:'Brazilian Rose Diamond',  price:'From €11.45', url:'https://mochabeans.com/products/brazilian-rose-diamond-cerrado', desc:'Rich, deep nutty sweetness with heavy body. Bold and exceptional for espresso.',                  roast:'Dark',        intensity:8 },
    { name:'Colombia Decaf Midas',    price:'From €11.45', url:'https://mochabeans.com/products/brazilian-decaf-midas-blend',    desc:'All the flavour of premium Colombian coffee, zero caffeine. Smooth at any time of day.',           roast:'Medium',      intensity:6 }
  ];

  var STEPS = [
    { q:'How do you brew your coffee?', opts:[
      { l:'Espresso',                 s:'Concentrated and bold'  },
      { l:'Moka Pot',                 s:'Rich and classic'       },
      { l:'French Press',             s:'Full body, immersion'   },
      { l:'Filter / V60 / AeroPress', s:'Clean and aromatic'     },
      { l:'Bean to Cup Machine',      s:'Automatic and fresh'    }
    ]},
    { q:'What flavour do you love?', opts:[
      { l:'Chocolate & Nutty', s:'Rich and comforting'  },
      { l:'Fruity & Bright',   s:'Vibrant and complex'  },
      { l:'Bold & Intense',    s:'Powerful and deep'    },
      { l:'No caffeine',       s:'All taste, zero buzz' }
    ]}
  ];

  var bar     = document.getElementById('mb-bar');
  var content = document.getElementById('mb-content');
  var closeB  = document.getElementById('mb-close-bar');
  var state   = { step:0, brew:null };

  function openBar() {
    state = { step:0, brew:null };
    renderStep();
    bar.classList.add('open');
  }

  function closeBar() {
    bar.classList.remove('open');
  }

  if (closeB) {
    closeB.onclick = function (e) {
      e.preventDefault();
      e.stopPropagation();
      closeBar();
    };
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeBar();
  });

  function renderStep() {
    var s = STEPS[state.step];
    var bars = STEPS.map(function (_,i) {
      return '<div class="mb-prog-bar' + (i <= state.step ? ' on':'') + '"></div>';
    }).join('');
    var opts = s.opts.map(function (o) {
      return '<button class="mb-opt" type="button" data-v="' + o.l + '">' +
        '<span class="mb-opt-l">' + o.l + '</span>' +
        '<span class="mb-opt-s">' + o.s + '</span>' +
      '</button>';
    }).join('');
    content.innerHTML =
      '<div class="mb-prog">' + bars + '</div>' +
      '<p class="mb-q">' + s.q + '</p>' +
      '<div class="mb-opts">' + opts + '</div>';

    content.querySelectorAll('.mb-opt').forEach(function (btn) {
      btn.onclick = function () {
        var v = btn.getAttribute('data-v');
        if (state.step === 0) { state.brew = v; state.step = 1; renderStep(); }
        else { renderResult(v); }
      };
    });
  }

  function renderResult(flavour) {
    var rec = PRODS[0];
    var f = flavour || '', b = state.brew || '';
    if (f === 'No caffeine') rec = PRODS[3];
    else if (f === 'Fruity & Bright') rec = PRODS[1];
    else if (f === 'Bold & Intense' || b.indexOf('Espresso') > -1 || b.indexOf('Moka') > -1) rec = PRODS[2];

    content.innerHTML =
      '<div class="mb-result">' +
        '<div class="mb-res-row">' +
          '<div>' +
            '<p class="mb-eyebrow">Your perfect match</p>' +
            '<h3 class="mb-res-name">' + rec.name + '</h3>' +
            '<p class="mb-res-price">' + rec.price + '</p>' +
            '<p class="mb-res-desc">' + rec.desc + '</p>' +
          '</div>' +
          '<div class="mb-res-right">' +
            '<div><span class="mb-meta-lbl">Roast</span><span class="mb-meta-val">' + rec.roast + '</span></div>' +
            '<div>' +
              '<span class="mb-meta-lbl">Intensity</span>' +
              '<div class="mb-bar"><div class="mb-bar-fill" id="mb-fill"></div></div>' +
            '</div>' +
            '<div class="mb-actions">' +
              '<a href="' + rec.url + '" class="mb-btn-primary" target="_blank" rel="noopener"><span>Order Now &nbsp;→</span></a>' +
              '<button type="button" class="mb-btn-sec" id="mb-restart">Start again</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    setTimeout(function () {
      var fill = document.getElementById('mb-fill');
      if (fill) fill.style.width = (rec.intensity * 10) + '%';
    }, 100);

    document.getElementById('mb-restart').onclick = function () {
      state = { step:0, brew:null };
      renderStep();
    };
  }

  /* ── Intercept nav links ── */
  function interceptLinks() {
    document.querySelectorAll('a[href]').forEach(function (a) {
      var href = (a.getAttribute('href') || '').toLowerCase();
      var text = (a.textContent || '').toLowerCase().trim();
      var hit  = href.indexOf('subscribe') > -1 || text === 'subscribe' ||
                 text === 'buy our coffee' || text.indexOf('buy our coffee') > -1;
      if (hit && a.closest('.header, .announcement-bar, .footer, nav, .banner__buttons')) {
        a.onclick = function () {
          try { sessionStorage.setItem('mb-open', '1'); } catch(e) {}
        };
      }
    });
  }

  /* ── Open on page load if flag set ── */
  function checkAutoOpen() {
    try {
      if (sessionStorage.getItem('mb-open') === '1') {
        sessionStorage.removeItem('mb-open');
        setTimeout(openBar, 400);
      }
    } catch(e) {}
  }

  /* ================================================================
     LOCATIONS PAGE ANIMATIONS
  ================================================================ */
  function initLocations() {
    var locSections = [];
    document.querySelectorAll('.shopify-section').forEach(function(sec) {
      var hasImg = sec.querySelector('img');
      var hasH2  = sec.querySelector('h2, h1, .title');
      if (hasImg && hasH2) locSections.push(sec);
    });

    if (!locSections.length) return;

    var isLocPage = window.location.pathname.indexOf('location') > -1;
    var counter   = document.getElementById('mb-loc-counter');
    var total     = locSections.length;

    locSections.forEach(function(sec) {
      sec.classList.add('mb-loc-section');

      var img = sec.querySelector('img');
      if (img) { img.classList.add('mb-parallax'); img.style.transformOrigin = 'center center'; }

      sec.querySelectorAll('h1, h2, h3').forEach(function(t) {
        if (t.closest('#mb-bar, #mb-ticker')) return;
        if (t.dataset.mbLoc) return;
        t.dataset.mbLoc = '1';
        t.classList.add('mb-loc-title');
        var inner = document.createElement('span');
        inner.className = 'mb-loc-inner';
        inner.innerHTML = t.innerHTML;
        t.innerHTML = '';
        t.appendChild(inner);
      });

      sec.querySelectorAll('p, address, .subtitle').forEach(function(p) {
        if (p.dataset.mbLoc) return;
        p.dataset.mbLoc = '1';
        p.classList.add('mb-loc-addr');
      });

      var line = document.createElement('span');
      line.className = 'mb-loc-line';
      var textArea = sec.querySelector('.banner__content, .image-banner__content, [class*="content"]');
      if (textArea) textArea.appendChild(line);
    });

    var ticking = false;
    window.addEventListener('scroll', function() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        locSections.forEach(function(sec) {
          var img = sec.querySelector('.mb-parallax');
          if (!img) { ticking = false; return; }
          var rect   = sec.getBoundingClientRect();
          var center = rect.top + rect.height / 2;
          var offset = (window.innerHeight / 2 - center) * 0.12;
          img.style.transform = 'translateY(' + offset + 'px) scale(1.08)';
        });

        if (counter && isLocPage) {
          var current = 1;
          locSections.forEach(function(sec, i) {
            var rect = sec.getBoundingClientRect();
            if (rect.top < window.innerHeight * 0.5) current = i + 1;
          });
          var num = String(current).padStart(2,'0');
          var tot = String(total).padStart(2,'0');
          counter.innerHTML = '<span>' + num + '</span> / ' + tot;
          counter.classList.add('show');
        }
        ticking = false;
      });
    }, { passive: true });

    var locObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var sec = entry.target;
        sec.classList.toggle('mb-loc-active', entry.isIntersecting);
        sec.querySelectorAll('.mb-loc-title, .mb-loc-addr, .mb-loc-line').forEach(function(el) {
          if (entry.isIntersecting) el.classList.add('mb-loc-in');
        });
      });
    }, { threshold: 0.25 });

    locSections.forEach(function(sec) { locObs.observe(sec); });
    if (counter && isLocPage) counter.classList.add('show');
  }

  /* ── INIT ── */
  function init() {
    initHeader();
    initArrow();
    applyReveal();
    watchReveal();
    initText();
    heroSeq();
    initMag();
    initImgs();
    interceptLinks();
    checkAutoOpen();
    initLocations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('shopify:section:load', function () {
    applyReveal(); watchReveal(); interceptLinks();
  });

})();
</script>
