{%- comment -%}
  Usage: {% render 'product-card', product: product, delay: 1 %}
  `delay` (0-3) staggers the scroll-reveal animation, capped at 4 steps.
{%- endcomment -%}
{%- capture brand -%}{% render 'brand-of', product: product %}{%- endcapture -%}
{%- assign brand = brand | strip -%}
{%- capture gender -%}{% render 'gender-of', product: product %}{%- endcapture -%}
{%- capture occasion -%}{% render 'occasion-of', product: product %}{%- endcapture -%}
{%- capture ptype -%}{% render 'product-type-of', product: product %}{%- endcapture -%}
{%- capture colour -%}{% render 'colour-of', product: product %}{%- endcapture -%}
{%- assign colour = colour | strip -%}
{%- capture cleaned -%}{% render 'clean-title', title: product.title %}{%- endcapture -%}
{%- assign clean_parts = cleaned | strip | split: '::' -%}
{%- assign clean_title = clean_parts[0] -%}
{%- assign delivery_tag = clean_parts[1] -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign save_pct = 0 -%}
{%- if on_sale -%}
  {%- assign diff = product.compare_at_price | minus: product.price -%}
  {%- assign save_pct = diff | times: 100 | divided_by: product.compare_at_price -%}
{%- endif -%}
{%- assign age_list = '' -%}
{%- assign size_list = '' -%}
{%- for v in product.variants -%}
  {%- capture band -%}{% render 'variant-age-band', variant: v %}{%- endcapture -%}
  {%- assign age_list = age_list | append: band | strip | append: '|' -%}
  {%- capture size_label -%}{% render 'variant-size-label', variant: v %}{%- endcapture -%}
  {%- assign size_label = size_label | strip -%}
  {%- if size_label != '' -%}
    {%- assign size_list = size_list | append: size_label | append: '|' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign age_array = age_list | split: '|' | uniq -%}
{%- assign size_array = size_list | split: '|' | uniq -%}

{%- comment -%} Real signals only — nothing here is invented. {%- endcomment -%}
{%- assign is_preorder = false -%}
{%- if product.tags contains 'Preorder' or product.tags contains 'Pre-order' or product.tags contains 'preorder' -%}{%- assign is_preorder = true -%}{%- endif -%}
{%- assign is_exclusive = false -%}
{%- if brand == 'Little Bo Peep' -%}{%- assign is_exclusive = true -%}{%- endif -%}
{%- assign now_ts = 'now' | date: '%s' | plus: 0 -%}
{%- assign created_ts = product.created_at | date: '%s' | plus: 0 -%}
{%- assign age_days = now_ts | minus: created_ts | divided_by: 86400 -%}
{%- assign is_new = false -%}
{%- if age_days <= 21 -%}{%- assign is_new = true -%}{%- endif -%}
{%- assign total_inventory = 0 -%}
{%- assign inventory_tracked = false -%}
{%- for v in product.variants -%}
  {%- if v.inventory_management -%}
    {%- assign inventory_tracked = true -%}
    {%- assign total_inventory = total_inventory | plus: v.inventory_quantity -%}
  {%- endif -%}
{%- endfor -%}
{%- assign is_low_stock = false -%}
{%- if inventory_tracked and product.available and total_inventory > 0 and total_inventory <= 3 -%}{%- assign is_low_stock = true -%}{%- endif -%}

<article class="lbp-card lbp-reveal"{% if delay %} data-delay="{{ delay }}"{% endif %}
  data-brand="{{ brand | escape }}"
  data-ages="{{ age_array | join: '|' | escape }}"
  data-sizes="{{ size_array | join: '|' | escape }}"
  data-colour="{{ colour | escape }}"
  data-gender="{{ gender | strip | escape }}"
  data-occasion="{{ occasion | strip | escape }}"
  data-type="{{ ptype | strip | escape }}"
  data-price="{{ product.price | money_without_currency | remove: ',' }}"
  data-created="{{ product.created_at | date: '%s' }}"
  data-pband="{% if product.price < 5000 %}Under &euro;50{% elsif product.price < 10000 %}&euro;50 &ndash; &euro;100{% elsif product.price < 20000 %}&euro;100 &ndash; &euro;200{% else %}&euro;200+{% endif %}"
  data-stock="{% if product.available %}in{% else %}out{% endif %}">
  <div class="lbp-card__media">
    <a class="lbp-card__medialink" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image != blank -%}
      <img class="lbp-card__img" src="{{ product.featured_image | image_url: width: 700 }}"
           alt="{{ product.featured_image.alt | default: clean_title | escape }}" loading="lazy" decoding="async" width="700" height="875">
      {%- if product.images.size > 1 -%}
      <img class="lbp-card__img lbp-card__img--alt" src="{{ product.images[1] | image_url: width: 700 }}" alt="" loading="lazy" decoding="async" aria-hidden="true">
      {%- endif -%}
      {%- else -%}
      <span class="lbp-noimg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="5" width="18" height="14" rx="1"/><circle cx="9" cy="10" r="1.3"/><path d="m4 17 5-5 4 3 3-3 4 4"/></svg>
        <span>Photo coming soon</span>
      </span>
      {%- endif -%}
    </a>
    {%- if on_sale or is_preorder or is_new or is_exclusive or is_low_stock or product.available == false -%}
    <div class="lbp-card__flags">
      {%- comment -%} Restrained: sale/preorder take priority, then at most one more. {%- endcomment -%}
      {%- if on_sale -%}<span class="lbp-flag lbp-flag--sale">Sale</span>
      {%- elsif is_preorder -%}<span class="lbp-flag lbp-flag--pre">Pre-order</span>
      {%- elsif is_new -%}<span class="lbp-flag lbp-flag--new">New</span>
      {%- elsif is_exclusive -%}<span class="lbp-flag lbp-flag--exclusive">Exclusive</span>
      {%- endif -%}
      {%- if is_low_stock -%}<span class="lbp-flag lbp-flag--low">Low stock</span>{%- endif -%}
      {%- unless product.available %}<span class="lbp-flag lbp-flag--out">Out of stock</span>{% endunless -%}
    </div>
    {%- endif -%}
    <button class="lbp-card__wish" type="button" aria-label="Save {{ clean_title | escape }}" data-wish data-product-id="{{ product.id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M12 20.5S3.8 15 3.8 9.3a4.3 4.3 0 0 1 8.2-1.8 4.3 4.3 0 0 1 8.2 1.8c0 5.7-8.2 11.2-8.2 11.2Z"/>
      </svg>
    </button>
    {%- if product.available -%}
    <button class="lbp-card__quick" type="button" data-quick-add data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-url="{{ product.url }}">Quick add</button>
    {%- endif -%}
  </div>
  {%- if brand != blank -%}<p class="lbp-card__brand">{{ brand }}</p>{%- endif -%}
  <h3 class="lbp-card__name"><a class="lbp-card__link" href="{{ product.url }}">{{ clean_title }}</a></h3>
  <p class="lbp-card__price">
    {%- if on_sale -%}
    <span class="lbp-card__was lbp-num">{{ product.compare_at_price | money }}</span>
    <span class="lbp-card__now lbp-card__now--sale lbp-num">{{ product.price | money }}</span>
    {%- if save_pct > 0 -%}<span class="lbp-card__save lbp-num">Save {{ save_pct }}%</span>{%- endif -%}
    {%- else -%}
    <span class="lbp-card__now lbp-num">{{ product.price | money }}</span>
    {%- endif -%}
    {%- if delivery_tag != blank -%}<span class="lbp-tag">{{ delivery_tag }}</span>{%- endif -%}
  </p>
</article>
