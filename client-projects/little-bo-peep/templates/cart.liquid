<div class="cart-page">
  <h1 class="cart-title">Shopping Bag</h1>

  {% if cart.item_count > 0 %}
    <div class="cart-content">
      <!-- Cart Items -->
      <div class="cart-items">
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-item" data-item-key="{{ item.key }}">
                <td class="cart-item__product">
                  <a href="{{ item.url }}" class="cart-item__image">
                    <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}">
                  </a>
                  <div>
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.title }}</a>
                    {% if item.variant.title != 'Default Title' %}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {% endif %}
                  </div>
                </td>
                <td class="cart-item__price">€{{ item.price | money_without_currency }}</td>
                <td class="cart-item__quantity">
                  <form action="/cart/change" method="post" class="quantity-form">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input
                      type="number"
                      name="quantity"
                      value="{{ item.quantity }}"
                      min="0"
                      max="10"
                      class="quantity-input"
                    >
                  </form>
                </td>
                <td class="cart-item__total">€{{ item.line_price | money_without_currency }}</td>
                <td class="cart-item__remove">
                  <form action="/cart/change" method="post">
                    <input type="hidden" name="id" value="{{ item.key }}">
                    <input type="hidden" name="quantity" value="0">
                    <button type="submit" class="remove-btn" aria-label="Remove {{ item.title }}">×</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Cart Summary -->
      <div class="cart-summary">
        <h2 class="cart-summary__title">Order Summary</h2>

        <div class="summary-row">
          <span>Subtotal</span>
          <span>€{{ cart.subtotal_price | money_without_currency }}</span>
        </div>

        <div class="summary-row">
          <span>Shipping</span>
          <span>Calculated at checkout</span>
        </div>

        {% if cart.total_discount > 0 %}
          <div class="summary-row summary-row--discount">
            <span>Discount</span>
            <span>-€{{ cart.total_discount | money_without_currency }}</span>
          </div>
        {% endif %}

        <div class="summary-row summary-row--total">
          <span>Total</span>
          <span>€{{ cart.total_price | money_without_currency }}</span>
        </div>

        <!-- Promo Code -->
        <form action="/cart/update" method="post" class="promo-form">
          <input
            type="text"
            name="note"
            placeholder="Enter promo code"
            class="promo-input"
          >
          <button type="submit" class="button button--secondary">Apply</button>
        </form>

        <!-- Checkout Button -->
        <form action="/checkout" method="post" class="checkout-form">
          <button type="submit" class="button button--primary button--large">
            Proceed to Checkout
          </button>
        </form>

        <!-- Continue Shopping -->
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary button--large">
          Continue Shopping
        </a>

        <!-- Trust Info -->
        <div class="cart-trust">
          <p><strong>🔒 Secure Checkout</strong> — Your payment information is protected.</p>
          <p><strong>📦 Fast Shipping</strong> — Next-day dispatch to Ireland &amp; UK.</p>
          <p><strong>↩️ 14-Day Returns</strong> — Hassle-free returns and exchanges.</p>
        </div>
      </div>
    </div>
  {% else %}
    <div class="cart-empty">
      <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <h2>Your bag is empty</h2>
      <p>Continue shopping to find something special.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary button--large">
        Start Shopping
      </a>
    </div>
  {% endif %}
</div>

<style>
  .cart-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md);
  }

  .cart-title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .cart-content {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--space-2xl);
  }

  .cart-items {
    overflow-x: auto;
  }

  .cart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-body);
  }

  .cart-table th {
    text-align: left;
    padding: var(--space-md);
    border-bottom: 2px solid var(--color-border);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--font-size-small);
  }

  .cart-table td {
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item__product {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .cart-item__image {
    flex-shrink: 0;
  }

  .cart-item__image img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .cart-item__title {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .cart-item__variant {
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  .quantity-form {
    display: flex;
  }

  .quantity-input {
    width: 60px;
    padding: var(--space-xs);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-align: center;
    font-family: inherit;
  }

  .quantity-input:focus {
    outline: none;
    border-color: var(--color-accent-coral);
  }

  .remove-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .remove-btn:hover {
    color: var(--color-accent-coral);
  }

  .cart-summary {
    background-color: var(--color-bg-secondary);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    height: fit-content;
    position: sticky;
    top: 100px;
  }

  .cart-summary__title {
    font-size: var(--font-size-h4);
    margin-bottom: var(--space-lg);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-body);
  }

  .summary-row--total {
    border-bottom: none;
    font-weight: 600;
    font-size: var(--font-size-h4);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .summary-row--discount {
    color: var(--color-accent-coral);
  }

  .promo-form {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .promo-input {
    flex: 1;
    padding: var(--space-sm);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
  }

  .promo-input:focus {
    outline: none;
    border-color: var(--color-accent-coral);
  }

  .checkout-form {
    margin-bottom: var(--space-md);
  }

  .checkout-form button {
    width: 100%;
  }

  .cart-trust {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-small);
  }

  .cart-trust p {
    margin-bottom: var(--space-sm);
  }

  .cart-empty {
    text-align: center;
    padding: var(--space-3xl) var(--space-lg);
  }

  .empty-icon {
    width: 80px;
    height: 80px;
    color: var(--color-text-secondary);
    margin: 0 auto var(--space-lg);
    opacity: 0.5;
  }

  .cart-empty h2 {
    font-size: var(--font-size-h2);
    margin-bottom: var(--space-md);
  }

  .cart-empty p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 768px) {
    .cart-content {
      grid-template-columns: 1fr;
    }

    .cart-summary {
      position: static;
    }

    .cart-table {
      font-size: var(--font-size-small);
    }

    .cart-table th,
    .cart-table td {
      padding: var(--space-sm);
    }

    .cart-item__image img {
      width: 80px;
      height: 80px;
    }

    .promo-form {
      flex-direction: column;
    }
  }
</style>

<script>
  // Auto-update cart when quantity changes
  document.querySelectorAll('.quantity-input').forEach(input => {
    input.addEventListener('change', () => {
      input.closest('form').submit();
    });
  });
</script>
