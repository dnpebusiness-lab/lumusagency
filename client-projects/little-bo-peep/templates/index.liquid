<!-- Hero Section -->
<section class="hero" role="img" aria-label="Little Bo Peep hero banner">
  <div class="hero__content">
    <h1 class="hero__title">Timeless Children's Clothing to Treasure</h1>
    <p class="hero__subtitle">Beautiful Spanish and traditional children's clothing, carefully chosen for babies and children.</p>
    <a href="{{ collections.all.url }}" class="button button--primary button--large">
      Shop New Arrivals
      <svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
  <img
    src="{{ 'hero-placeholder.jpg' | asset_url }}"
    alt="Hero banner with children's clothing"
    class="hero__image"
    loading="eager"
    width="1280"
    height="600"
  >
</section>

<!-- Category Cards -->
<section class="categories" aria-labelledby="categories-heading">
  <h2 id="categories-heading" class="section-title">Shop by Category</h2>
  <div class="categories__grid">
    {% for category in 'Girls,Boys,Baby,Spanish Clothing,Occasionwear,New In' | split: ',' %}
      <a href="#" class="category-card" aria-label="Shop {{ category }}">
        <div class="category-card__image">
          <img
            src="{{ 'category-placeholder.jpg' | asset_url }}"
            alt="{{ category }}"
            loading="lazy"
            width="400"
            height="400"
          >
        </div>
        <h3 class="category-card__title">{{ category }}</h3>
        <span class="category-card__arrow">→</span>
      </a>
    {% endfor %}
  </div>
</section>

<!-- Featured Collection -->
<section class="featured-collection" aria-labelledby="featured-heading">
  <div class="featured-collection__content">
    <h2 id="featured-heading" class="section-title">Little Bo Peep Smocks</h2>
    <p class="featured-collection__description">
      Discover our exclusive smock collection, designed for special occasions and everyday wear. Each piece is carefully selected for quality and style.
    </p>
    <a href="#" class="button button--secondary">
      Explore Collection
    </a>
  </div>

  <div class="featured-collection__products">
    {% assign featured_products = collections.all.products | first: 4 %}
    {% for product in featured_products %}
      <div class="product-card" data-product-id="{{ product.id }}">
        <div class="product-card__image">
          <img
            src="{{ product.featured_image.src | image_url: width: 500 }}"
            alt="{{ product.featured_image.alt | escape }}"
            loading="lazy"
            width="400"
            height="400"
          >
          {% if product.compare_at_price > product.price %}
            <span class="badge badge--sale">Sale</span>
          {% endif %}
        </div>
        <div class="product-card__content">
          <p class="product-card__brand">{{ product.vendor }}</p>
          <h3 class="product-card__title">{{ product.title }}</h3>
          <div class="product-card__price">
            {% if product.compare_at_price > product.price %}
              <span class="price price--compare">€{{ product.compare_at_price | money_without_currency }}</span>
            {% endif %}
            <span class="price price--current">€{{ product.price | money_without_currency }}</span>
          </div>
          <button
            class="button button--small button--add-to-cart"
            data-product-id="{{ product.id }}"
            aria-label="Add {{ product.title }} to cart"
          >
            Add to Bag
          </button>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<!-- New Arrivals -->
<section class="new-arrivals" aria-labelledby="new-arrivals-heading">
  <h2 id="new-arrivals-heading" class="section-title">New Arrivals</h2>

  <div class="product-grid">
    {% assign new_products = collections.all.products | first: 8 %}
    {% for product in new_products %}
      {% include 'product-card', product: product %}
    {% endfor %}
  </div>

  <div class="section-cta">
    <a href="{{ collections.all.url }}" class="button button--secondary">
      View All Products
    </a>
  </div>
</section>

<!-- Brand Spotlight -->
<section class="brand-spotlight">
  <div class="brand-spotlight__image">
    <img
      src="{{ 'brand-spotlight.jpg' | asset_url }}"
      alt="Featured brand collection"
      loading="lazy"
      width="600"
      height="400"
    >
  </div>
  <div class="brand-spotlight__content">
    <span class="brand-spotlight__eyebrow">Featured Brand</span>
    <h2 class="brand-spotlight__title">Miranda Spring Collection</h2>
    <p class="brand-spotlight__description">
      Italian luxury childrenswear with timeless designs. Carefully selected pieces for special occasions and everyday wear.
    </p>
    <a href="#" class="button button--primary">
      Discover Collection
    </a>
  </div>
</section>

<!-- Newsletter Section -->
<section class="newsletter" aria-labelledby="newsletter-heading">
  <h2 id="newsletter-heading" class="newsletter__title">Join the Little Bo Peep Family</h2>
  <p class="newsletter__subtitle">
    Be first to discover new arrivals, Spanish collections and seasonal favourites.
  </p>
  <form action="{{ routes.cart_url }}" method="post" class="newsletter__form" accept-charset="UTF-8">
    <input
      type="hidden"
      name="form_type"
      value="customer"
    >
    <input
      type="email"
      name="email"
      placeholder="Enter your email"
      required
      class="newsletter__input"
      aria-label="Email address"
    >
    <button type="submit" class="button button--primary">
      Subscribe
    </button>
  </form>
  <p class="newsletter__consent">
    We respect your privacy. Unsubscribe at any time.
  </p>
</section>
