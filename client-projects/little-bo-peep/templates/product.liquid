{% assign product = all_products[0] %}

<div class="product-page">
  <div class="product__container">
    <!-- Image Gallery -->
    <div class="product__gallery">
      <div class="gallery__main">
        <img
          src="{{ product.featured_image.src | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | escape }}"
          id="main-image"
          class="gallery__image"
          width="800"
          height="800"
        >
      </div>

      {% if product.images.size > 1 %}
        <div class="gallery__thumbnails">
          {% for image in product.images limit: 5 %}
            <button
              class="gallery__thumbnail"
              data-image-url="{{ image.src | image_url: width: 800 }}"
              data-image-alt="{{ image.alt | escape }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image.src | image_url: width: 150 }}"
                alt="{{ image.alt | escape }}"
                width="150"
                height="150"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="product__info">
      <p class="product__brand">{{ product.vendor }}</p>
      <h1 class="product__title">{{ product.title }}</h1>

      <!-- Rating (if available) -->
      {% if product.metafields.reviews.rating %}
        <div class="product__rating">
          <span class="rating-stars">★★★★★</span>
          <span class="rating-count">(42 reviews)</span>
        </div>
      {% endif %}

      <!-- Price -->
      <div class="product__price">
        {% if product.compare_at_price > product.price %}
          <span class="price price--compare">€{{ product.compare_at_price | money_without_currency }}</span>
          <span class="price price--sale">Sale</span>
        {% endif %}
        <span class="price price--current">€{{ product.price | money_without_currency }}</span>
      </div>

      <!-- Stock Status -->
      <div class="product__stock">
        {% if product.available %}
          {% if product.variants.first.inventory_quantity <= 5 %}
            <span class="stock-status stock-status--low">Low Stock</span>
          {% else %}
            <span class="stock-status stock-status--in">In Stock</span>
          {% endif %}
        {% else %}
          <span class="stock-status stock-status--out">Out of Stock</span>
        {% endif %}
      </div>

      <!-- Variant Selector -->
      <form id="product-form" class="product__form">
        {% for option in product.options_with_values %}
          <div class="form-group">
            <label for="option-{{ option.position }}" class="form-label">
              {{ option.name }}
            </label>
            <select
              id="option-{{ option.position }}"
              name="options[{{ option.name }}]"
              class="form-select"
              required
            >
              <option value="">Select {{ option.name }}</option>
              {% for value in option.values %}
                <option value="{{ value }}">{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}

        <!-- Quantity Selector -->
        <div class="form-group">
          <label for="quantity" class="form-label">Quantity</label>
          <div class="quantity-selector">
            <button type="button" class="quantity-btn quantity-btn--minus">−</button>
            <input
              type="number"
              id="quantity"
              name="quantity"
              value="1"
              min="1"
              max="10"
              class="quantity-input"
            >
            <button type="button" class="quantity-btn quantity-btn--plus">+</button>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="product__ctas">
          <button
            type="submit"
            class="button button--primary button--large"
            id="add-to-cart"
            {% unless product.available %}disabled{% endunless %}
          >
            Add to Bag
          </button>
          <button
            type="button"
            class="button button--secondary button--large"
            id="wishlist-btn"
            aria-label="Add to wishlist"
          >
            ♡
          </button>
        </div>
      </form>

      <!-- Trust Elements -->
      <div class="product__trust">
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Secure checkout</span>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11l3 3L22 4"></path>
          </svg>
          <span>14-day returns</span>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="1"></circle>
            <path d="M12 2v6m0 4v6"></path>
          </svg>
          <span>Next-day dispatch</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Description Tabs -->
  <div class="product__tabs">
    <div class="tabs__header">
      <button class="tab-btn active" data-tab="description">Description</button>
      <button class="tab-btn" data-tab="materials">Materials</button>
      <button class="tab-btn" data-tab="care">Care</button>
      <button class="tab-btn" data-tab="delivery">Delivery & Returns</button>
    </div>

    <div class="tabs__content">
      <div class="tab-content active" id="tab-description">
        <div class="rte">
          {{ product.description }}
        </div>
      </div>

      <div class="tab-content" id="tab-materials">
        <div class="rte">
          <p>Materials: {{ product.metafields.custom.materials | default: 'Please contact us for material details.' }}</p>
        </div>
      </div>

      <div class="tab-content" id="tab-care">
        <div class="rte">
          <p>Care instructions: Available upon request. Please contact us for detailed care information.</p>
        </div>
      </div>

      <div class="tab-content" id="tab-delivery">
        <div class="rte">
          <h3>Delivery</h3>
          <p>We aim for next-day dispatch. Ireland usually 1–2 days, UK 3–5 days.</p>
          <h3>Returns</h3>
          <p>Items can be returned within 14 days in perfect condition. Footwear must include original shoebox.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <section class="related-products" aria-labelledby="related-heading">
    <h2 id="related-heading" class="section-title">You May Also Like</h2>
    <div class="product-grid">
      <!-- Placeholder: will be populated with related products -->
      <p>Related products will appear here</p>
    </div>
  </section>
</div>

<style>
  .product-page {
    padding: var(--space-xl) var(--space-md);
  }

  .product__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    max-width: 1280px;
    margin: 0 auto var(--space-3xl);
  }

  .product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .gallery__main {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
  }

  .gallery__thumbnail {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid var(--color-border);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .gallery__thumbnail:hover,
  .gallery__thumbnail.active {
    border-color: var(--color-accent-coral);
  }

  .gallery__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__info {
    display: flex;
    flex-direction: column;
  }

  .product__brand {
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .product__title {
    font-size: 32px;
    margin-bottom: var(--space-md);
  }

  .product__rating {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-small);
  }

  .rating-stars {
    color: var(--color-accent-gold);
    font-size: 18px;
  }

  .product__price {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .price--current {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .price--compare {
    text-decoration: line-through;
    color: var(--color-text-secondary);
  }

  .price--sale {
    background-color: var(--color-accent-coral);
    color: white;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
  }

  .product__stock {
    margin-bottom: var(--space-lg);
  }

  .stock-status {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-small);
    font-weight: 600;
  }

  .stock-status--in {
    background-color: var(--color-accent-sage);
    color: white;
  }

  .stock-status--low {
    background-color: var(--color-accent-coral);
    color: white;
  }

  .stock-status--out {
    background-color: var(--color-text-secondary);
    color: white;
  }

  .product__form {
    margin-bottom: var(--space-lg);
  }

  .form-group {
    margin-bottom: var(--space-lg);
  }

  .form-label {
    display: block;
    font-size: var(--font-size-small);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  .form-select {
    width: 100%;
    padding: var(--space-sm);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-body);
    font-family: inherit;
    cursor: pointer;
  }

  .form-select:focus {
    outline: none;
    border-color: var(--color-accent-coral);
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .quantity-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background: none;
    border: none;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .quantity-btn:hover {
    background-color: var(--color-bg-secondary);
  }

  .quantity-input {
    width: 60px;
    text-align: center;
    border: none;
    font-size: var(--font-size-body);
    font-family: inherit;
  }

  .quantity-input:focus {
    outline: none;
  }

  .product__ctas {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  #add-to-cart {
    flex: 1;
  }

  #wishlist-btn {
    width: 50px;
    font-size: 24px;
  }

  .product__trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--font-size-small);
  }

  .trust-icon {
    width: 24px;
    height: 24px;
    color: var(--color-accent-coral);
    flex-shrink: 0;
  }

  .product__tabs {
    max-width: 1280px;
    margin: 0 auto var(--space-3xl);
  }

  .tabs__header {
    display: flex;
    gap: var(--space-md);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .tab-btn {
    padding: var(--space-md) 0;
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--color-text-secondary);
    border: none;
    background: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
  }

  .tab-btn:hover {
    color: var(--color-text-primary);
  }

  .tab-btn.active {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-accent-coral);
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .rte {
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
  }

  .rte h3 {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  .rte p {
    margin-bottom: var(--space-md);
  }

  @media (max-width: 768px) {
    .product__container {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .gallery__thumbnails {
      grid-template-columns: repeat(4, 1fr);
    }

    .product__ctas {
      flex-direction: column;
    }

    #wishlist-btn {
      width: auto;
    }
  }
</style>

<script>
  // Thumbnail click to update main image
  document.querySelectorAll('.gallery__thumbnail').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.gallery__thumbnail').forEach(b => b.classList.remove('active'));
      e.currentTarget.classList.add('active');
      document.getElementById('main-image').src = e.currentTarget.dataset.imageUrl;
      document.getElementById('main-image').alt = e.currentTarget.dataset.imageAlt;
    });
  });

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tabName = e.currentTarget.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      e.currentTarget.classList.add('active');
      document.getElementById('tab-' + tabName).classList.add('active');
    });
  });

  // Quantity controls
  document.querySelector('.quantity-btn--minus').addEventListener('click', () => {
    const input = document.getElementById('quantity');
    if (input.value > 1) input.value--;
  });

  document.querySelector('.quantity-btn--plus').addEventListener('click', () => {
    const input = document.getElementById('quantity');
    input.value++;
  });
</script>
