<footer class="lbp-footer"><div class="lbp-container">
  <div class="lbp-footer__top">
    <div>
      <p class="lbp-footer__brand">{{ shop.name }}</p>
      <p class="lbp-footer__blurb">An independently run children's boutique in Spiddal, Co Galway, specialising in traditional and Spanish childrenswear.</p>
      <form class="lbp-news__form" style="margin-top:32px" action="{{ routes.root_url }}" method="post">
        <label class="lbp-sr" for="nl">Email address</label>
        <input class="lbp-field" id="nl" name="contact[email]" type="email" placeholder="Email address" required>
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="&#x2713;">
        <button class="lbp-btn lbp-btn--ondark" type="submit">Join</button>
      </form>
    </div>
    <div><h2 class="lbp-footer__title">Shop</h2><ul class="lbp-footer__list">
      <li><a href="{{ routes.all_products_collection_url }}?sort=new">New in</a></li>
      <li><a href="{{ routes.all_products_collection_url }}">Designers</a></li>
      <li><a href="/#smocks">Smocks</a></li>
      <li><a href="{{ collections['summer-sale'].url | default: routes.all_products_collection_url }}">Sale</a></li>
    </ul></div>
    <div><h2 class="lbp-footer__title">Help</h2><ul class="lbp-footer__list">
      <li><a href="{{ pages.delivery.url | default: '#' }}">Delivery</a></li>
      <li><a href="{{ pages.returns.url | default: '#' }}">Returns</a></li>
      <li><a href="{{ pages['size-guide'].url | default: '#' }}">Size guide</a></li>
      <li><a href="{{ pages['payment-plans'].url | default: '#' }}">Payment plans</a></li>
    </ul></div>
    <div><h2 class="lbp-footer__title">Visit</h2><ul class="lbp-footer__list">
      <li><a href="https://maps.google.com/?q=Spiddal+Co+Galway" target="_blank" rel="noopener">Spiddal, Co Galway</a></li>
      <li><a href="https://instagram.com/little_bo_peep17" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="https://facebook.com/littlebopeep2017" target="_blank" rel="noopener">Facebook</a></li>
    </ul></div>
  </div>
  <div class="lbp-footer__bottom"><p>&copy; {{ shop.name }}, Spiddal.</p><p>{{ 'now' | date: '%Y' }}</p></div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
