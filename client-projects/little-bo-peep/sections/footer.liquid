<footer class="lbp-footer"><div class="lbp-container">
  <div class="lbp-footer__top">
    <div>
      <p class="lbp-footer__brand">{{ shop.name }}</p>
      <p class="lbp-footer__blurb">An independently run children's boutique in Spiddal, Co Galway, specialising in traditional and Spanish childrenswear &mdash; and home to our own signature smock collection, designed in Galway since 2017.</p>
      <p class="lbp-footer__news-title">A little something lovely, delivered to your inbox.</p>
      <form class="lbp-news__form" action="{{ routes.root_url }}" method="post">
        <label class="lbp-sr" for="nl">Your email address</label>
        <input class="lbp-field" id="nl" name="contact[email]" type="email" placeholder="Your email address" required>
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="&#x2713;">
        <button class="lbp-btn lbp-btn--ondark" type="submit">Join Us</button>
      </form>
    </div>
    <div><h2 class="lbp-footer__title">Shop</h2><ul class="lbp-footer__list">
      <li><a href="{{ routes.all_products_collection_url }}?sort=new">New In</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?gender=Girls">Girls</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?gender=Boys">Boys</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?gender=Baby">Baby</a></li>
      {%- capture footer_lbp_url -%}
        {%- if collections['little-bo-peeps'] -%}{{ collections['little-bo-peeps'].url }}{%- else -%}{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep{%- endif -%}
      {%- endcapture -%}
      <li><a href="{{ footer_lbp_url | strip }}">Little Bo Peep</a></li>
      <li><a href="{{ routes.all_products_collection_url }}?occasion=Occasion">Occasionwear</a></li>
      <li><a href="{{ collections['summer-sale'].url | default: routes.all_products_collection_url }}">Sale</a></li>
    </ul></div>
    <div><h2 class="lbp-footer__title">Help</h2><ul class="lbp-footer__list">
      {%- if pages.delivery -%}<li><a href="{{ pages.delivery.url }}">Delivery</a></li>{%- endif -%}
      {%- if pages.returns -%}<li><a href="{{ pages.returns.url }}">Returns</a></li>{%- endif -%}
      {%- if pages['size-guide'] -%}<li><a href="{{ pages['size-guide'].url }}">Size Guide</a></li>{%- endif -%}
      {%- if pages.faq -%}<li><a href="{{ pages.faq.url }}">FAQ</a></li>{%- endif -%}
      {%- if pages.contact -%}<li><a href="{{ pages.contact.url }}">Contact</a></li>{%- endif -%}
    </ul></div>
    <div><h2 class="lbp-footer__title">About</h2><ul class="lbp-footer__list">
      <li><a href="{{ pages['our-story'].url | default: pages['about-us'].url | default: '#' }}">Our Story</a></li>
      <li><a href="https://maps.google.com/?q=Spiddal+Co+Galway" target="_blank" rel="noopener">Our Boutique</a></li>
      <li><a href="{{ routes.all_products_collection_url }}">Brands</a></li>
    </ul></div>
    <div><h2 class="lbp-footer__title">Follow</h2><ul class="lbp-footer__list">
      <li><a href="https://instagram.com/little_bo_peep17" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="https://facebook.com/littlebopeep2017" target="_blank" rel="noopener">Facebook</a></li>
    </ul></div>
  </div>
  <div class="lbp-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}, Spiddal.</p>
    <div class="lbp-footer__legal">
      {%- if shop.policies.privacy_policy -%}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a>{%- endif -%}
      {%- if shop.policies.terms_of_service -%}<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>{%- endif -%}
      {%- if shop.policies.shipping_policy -%}<a href="{{ shop.policies.shipping_policy.url }}">Shipping</a>{%- endif -%}
      {%- if shop.policies.refund_policy -%}<a href="{{ shop.policies.refund_policy.url }}">Returns Policy</a>{%- endif -%}
    </div>
    <p class="lbp-footer__secure">Secure checkout &middot; Worldwide delivery</p>
  </div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
