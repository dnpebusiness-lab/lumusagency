{% stylesheet %}
  .cart-drawer {
    position: fixed;
    right: -400px;
    top: 0;
    width: 400px;
    height: 100vh;
    background-color: white;
    box-shadow: -8px 0 16px rgba(0, 0, 0, 0.1);
    z-index: var(--z-modal);
    transition: right var(--transition-medium);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.active {
    right: 0;
  }

  .cart-drawer__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-medium);
    z-index: var(--z-modal) - 1;
  }

  .cart-drawer.active ~ .cart-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__title {
    font-size: var(--font-size-body);
    font-weight: 600;
  }

  .cart-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .cart-drawer__close:hover {
    color: var(--color-accent-coral);
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-md);
  }

  .cart-drawer__item {
    display: flex;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__item-image {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .cart-drawer__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__item-title {
    font-weight: 600;
    font-size: var(--font-size-small);
    margin-bottom: var(--space-xs);
  }

  .cart-drawer__item-variant {
    font-size: 12px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .cart-drawer__item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .cart-drawer__item-price {
    font-weight: 600;
    font-size: var(--font-size-small);
  }

  .cart-drawer__item-remove {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    font-size: 16px;
    transition: color var(--transition-fast);
  }

  .cart-drawer__item-remove:hover {
    color: var(--color-accent-coral);
  }

  .cart-drawer__empty {
    text-align: center;
    padding: var(--space-2xl) var(--space-md);
    color: var(--color-text-secondary);
  }

  .cart-drawer__footer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cart-drawer__actions button {
    width: 100%;
  }

  @media (max-width: 768px) {
    .cart-drawer {
      width: 100%;
      right: -100%;
    }
  }
{% endstylesheet %}

<div class="cart-drawer" id="cart-drawer" role="complementary" aria-label="Shopping cart">
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">Shopping Bag</h2>
    <button class="cart-drawer__close" id="close-cart" aria-label="Close cart">×</button>
  </div>

  <div class="cart-drawer__items" id="cart-items-container">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="cart-drawer__item">
          <div class="cart-drawer__item-image">
            <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}">
          </div>
          <div class="cart-drawer__item-content">
            <h3 class="cart-drawer__item-title">{{ item.title }}</h3>
            {% if item.variant.title != 'Default Title' %}
              <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
            {% endif %}
            <div class="cart-drawer__item-footer">
              <span class="cart-drawer__item-price">€{{ item.price | money_without_currency }} × {{ item.quantity }}</span>
              <button class="cart-drawer__item-remove" data-item-key="{{ item.key }}">✕</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="cart-drawer__empty">
        <p>Your bag is empty</p>
      </div>
    {% endif %}
  </div>

  <div class="cart-drawer__footer">
    {% if cart.item_count > 0 %}
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span>€{{ cart.subtotal_price | money_without_currency }}</span>
      </div>

      <div class="cart-drawer__actions">
        <a href="{{ routes.cart_url }}" class="button button--secondary">
          View Cart
        </a>
        <form action="/checkout" method="post">
          <button type="submit" class="button button--primary">
            Checkout
          </button>
        </form>
      </div>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
        Continue Shopping
      </a>
    {% endif %}
  </div>
</div>

<div class="cart-drawer__overlay" id="cart-overlay"></div>

<script>
  const cartDrawer = document.getElementById('cart-drawer');
  const closeBtn = document.getElementById('close-cart');
  const overlay = document.getElementById('cart-overlay');
  const cartToggle = document.getElementById('cart-toggle');

  // Toggle cart on header button click
  if (cartToggle) {
    cartToggle.addEventListener('click', (e) => {
      e.preventDefault();
      cartDrawer.classList.toggle('active');
    });
  }

  // Close cart
  closeBtn.addEventListener('click', () => {
    cartDrawer.classList.remove('active');
  });

  overlay.addEventListener('click', () => {
    cartDrawer.classList.remove('active');
  });

  // Remove item from cart
  document.querySelectorAll('.cart-drawer__item-remove').forEach(btn => {
    btn.addEventListener('click', () => {
      const itemKey = btn.dataset.itemKey;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: itemKey, quantity: 0 })
      }).then(() => location.reload());
    });
  });
</script>
