<div class="lbp-scrim" data-scrim></div>
<aside class="lbp-drawer" data-drawer="bag" aria-label="Shopping bag" aria-hidden="true">
  <div class="lbp-drawer__head"><h2 class="lbp-drawer__title">Your bag</h2>
    <button class="lbp-iconbtn" type="button" aria-label="Close bag" data-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="lbp-drawer__body" data-bagbody>
    {% if cart.item_count > 0 %}
      <div class="lbp-bag" id="bag-items">
        {% for item in cart.items %}
        <div class="lbp-bagitem" data-line="{{ forloop.index }}" data-line-key="{{ item.key }}">
          <a class="lbp-bagitem__media" href="{{ item.url }}">
            {%- if item.image != blank -%}
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="125" loading="lazy">
            {%- else -%}
            <span class="lbp-noimg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="5" width="18" height="14" rx="1"/><circle cx="9" cy="10" r="1.3"/><path d="m4 17 5-5 4 3 3-3 4 4"/></svg></span>
            {%- endif -%}
          </a>
          <div class="lbp-bagitem__body">
            <p class="lbp-bagitem__name"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
            {% unless item.variant.title == 'Default Title' %}
              <p class="lbp-bagitem__variant">{{ item.variant.title }}</p>
            {% endunless %}
            <div class="lbp-bagitem__row">
              <div class="lbp-qty" data-qty>
                <button class="lbp-qty__btn" type="button" data-qty-down aria-label="Decrease quantity">&minus;</button>
                <span class="lbp-qty__n lbp-num">{{ item.quantity }}</span>
                <button class="lbp-qty__btn" type="button" data-qty-up aria-label="Increase quantity">+</button>
              </div>
              <span class="lbp-bagitem__price lbp-num">{{ item.final_line_price | money }}</span>
            </div>
          </div>
          <button class="lbp-bagitem__remove" type="button" data-remove aria-label="Remove {{ item.product.title | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </div>
        {% endfor %}
      </div>
      <div class="lbp-bagfoot">
        <div class="lbp-bagfoot__row"><span>Subtotal</span><span class="lbp-num">{{ cart.total_price | money }}</span></div>
        <p class="lbp-bagfoot__note">Taxes included. Shipping calculated at checkout.</p>
        <a class="lbp-btn lbp-btn--solid lbp-btn--block" href="{{ routes.cart_url }}">View bag</a>
        <a class="lbp-btn lbp-btn--line lbp-btn--block" href="{{ routes.root_url }}checkout">Checkout</a>
      </div>
    {% else %}
      <div class="lbp-empty"><p class="lbp-empty__title">Nothing in the bag yet.</p>
        <p class="lbp-empty__text">Have a look at what came in this week.</p>
        <a class="lbp-btn lbp-btn--line" href="{{ routes.all_products_collection_url }}?sort=new" data-close>Shop new in</a></div>
    {% endif %}
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
