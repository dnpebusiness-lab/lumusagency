<div class="lbp-promo" id="promo" data-promo hidden>
  <div class="lbp-promo__scrim" data-promo-close></div>
  <div class="lbp-promo__card" role="dialog" aria-modal="true" aria-labelledby="promo-title">
    <button class="lbp-promo__close" type="button" aria-label="Close" data-promo-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
    <span class="lbp-eyebrow lbp-promo__eyebrow">For new customers</span>
    <h2 class="lbp-h3 lbp-promo__title" id="promo-title">10% off your first order</h2>
    <p class="lbp-promo__text">Use the code below at checkout.</p>
    <div class="lbp-promo__codebox">
      <span class="lbp-promo__code">FIRST</span>
      <button class="lbp-btn lbp-btn--line lbp-promo__copy" type="button" data-promo-copy data-code="FIRST">Copy code</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "First-order promo",
  "settings": []
}
{% endschema %}
