<section class="lbp-hero" id="hero">
  <div class="lbp-hero__grid">
    <div class="lbp-hero__copy">
      <span class="lbp-eyebrow lbp-hero__eyebrow">Autumn / Winter</span>
      <h1 class="lbp-display lbp-hero__title">Spanish &amp; traditional childrenswear, <em>newborn to twelve</em>.</h1>
      <p class="lbp-lead lbp-hero__text">An independent boutique in Spiddal, twelve miles along the coast from Galway city &mdash; dressing Irish children in the pieces made for christenings, communions and Sunday best, and in easy everyday wear too.</p>
      <div class="lbp-hero__actions">
        <a class="lbp-btn lbp-btn--solid" href="{{ routes.all_products_collection_url }}?sort=new">Shop New Arrivals</a>
        <a class="lbp-btn lbp-btn--line" href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep">Shop the Little Bo Peep Collection</a>
      </div>
    </div>
    <figure class="lbp-hero__figure">
      <img src="{{ 'IMG_2622.jpg' | file_img_url: '1400x' }}" alt="Cream/ Red 3 Piece Naxos Suit" fetchpriority="high" decoding="async">
      <figcaption class="lbp-hero__caption">Naxos</figcaption>
    </figure>
  </div>
</section>

{%- comment -%}
  One real product photo per category, found in a single pass over the
  catalogue (gender/occasion aren't structured fields — see
  CATALOGUE-AUDIT.md §2.3 — so this is a best-effort keyword match, same
  technique as the New In / Smock sections below).
{%- endcomment -%}
{%- assign img_girls = '' -%}{%- assign img_boys = '' -%}{%- assign img_baby = '' -%}
{%- assign img_christening = '' -%}{%- assign img_occasion = '' -%}{%- assign img_lbp = '' -%}
{%- assign lbp_img1 = '' -%}{%- assign lbp_img2 = '' -%}{%- assign lbp_img3 = '' -%}
{%- assign lbp_url = routes.all_products_collection_url | append: '?brand=Little+Bo+Peep' -%}
{%- assign cat_found = 0 -%}
{%- assign lbp_found = 0 -%}
{%- for p in collections.all.products limit: 200 -%}
  {%- if cat_found >= 6 and lbp_found >= 3 -%}{%- break -%}{%- endif -%}
  {%- capture g -%}{% render 'gender-of', product: p %}{%- endcapture -%}
  {%- capture o -%}{% render 'occasion-of', product: p %}{%- endcapture -%}
  {%- capture b -%}{% render 'brand-of', product: p %}{%- endcapture -%}
  {%- assign b = b | strip -%}
  {%- if img_girls == '' and g contains 'Girls' -%}{%- assign img_girls = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
  {%- if img_boys == '' and g contains 'Boys' -%}{%- assign img_boys = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
  {%- if img_baby == '' and g contains 'Baby' -%}{%- assign img_baby = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
  {%- if img_christening == '' and o contains 'Christening' -%}{%- assign img_christening = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
  {%- if img_occasion == '' and o contains 'Occasion' -%}{%- assign img_occasion = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
  {%- if b == 'Little Bo Peep' -%}
    {%- if img_lbp == '' -%}{%- assign img_lbp = p.featured_image -%}{%- assign cat_found = cat_found | plus: 1 -%}{%- endif -%}
    {%- if lbp_img1 == '' -%}{%- assign lbp_img1 = p.featured_image -%}
    {%- elsif lbp_img2 == '' -%}{%- assign lbp_img2 = p.featured_image -%}
    {%- elsif lbp_img3 == '' -%}{%- assign lbp_img3 = p.featured_image -%}{%- endif -%}
    {%- assign lbp_found = lbp_found | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section id="shop-by-category">
  <div class="lbp-container">
    <div class="lbp-sectionhead lbp-reveal">
      <div><span class="lbp-eyebrow">Where to start</span><h2 class="lbp-h2 lbp-sectionhead__title">Shop by category</h2></div>
    </div>
    <div class="lbp-tiles{% if lbp_found > 0 %} lbp-tiles--four{% endif %}">
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?gender=Girls">
        <div class="lbp-tile__media lbp-mask">{% if img_girls != blank %}<img src="{{ img_girls | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name">Girls</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?gender=Boys">
        <div class="lbp-tile__media lbp-mask">{% if img_boys != blank %}<img src="{{ img_boys | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name">Boys</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?gender=Baby">
        <div class="lbp-tile__media lbp-mask">{% if img_baby != blank %}<img src="{{ img_baby | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name">Baby</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
      {%- if lbp_found > 0 -%}
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep">
        <div class="lbp-tile__media lbp-mask">{% if img_lbp != blank %}<img src="{{ img_lbp | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name" style="color:var(--accent)">Little Bo Peep Collection</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if lbp_found > 0 -%}
<section class="lbp-section" id="signature">
  <div class="lbp-container">
    <div class="lbp-signature">
      <div class="lbp-signature__copy lbp-reveal">
        <span class="lbp-eyebrow">Since 2017</span>
        <h2 class="lbp-h2 lbp-signature__title">Designed by Little Bo Peep</h2>
        <p class="lbp-lead lbp-signature__text">Our own smock collection, designed in Galway and cut for the days a childhood is remembered in &mdash; first birthdays, christenings, the walk home from Mass. Nine years on, it's still made the way we started it.</p>
        <a class="lbp-btn lbp-btn--solid" href="{{ lbp_url }}">Discover the Collection</a>
      </div>
      <div class="lbp-signature__media">
        <figure class="lbp-signature__main lbp-mask lbp-reveal" data-delay="1">
          {% if lbp_img1 != blank %}<img src="{{ lbp_img1 | image_url: width: 1000 }}" alt="" loading="lazy" decoding="async">{% endif %}
        </figure>
        <figure class="lbp-signature__detail lbp-mask lbp-reveal" data-delay="2">
          {% if lbp_img2 != blank %}<img src="{{ lbp_img2 | image_url: width: 700 }}" alt="" loading="lazy" decoding="async">{% endif %}
        </figure>
        <figure class="lbp-signature__detail lbp-mask lbp-reveal" data-delay="3">
          {% if lbp_img3 != blank %}<img src="{{ lbp_img3 | image_url: width: 700 }}" alt="" loading="lazy" decoding="async">{% endif %}
        </figure>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

<section class="lbp-section lbp-section--sand" id="occasion">
  <div class="lbp-container">
    <div class="lbp-sectionhead lbp-reveal">
      <div><span class="lbp-eyebrow">For the big days</span><h2 class="lbp-h2 lbp-sectionhead__title">Shop by occasion</h2></div>
    </div>
    <div class="lbp-tiles" style="grid-template-columns:repeat(2, minmax(0, 1fr))">
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?occasion=Christening">
        <div class="lbp-tile__media lbp-mask">{% if img_christening != blank %}<img src="{{ img_christening | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name">Christening</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
      <a class="lbp-tile lbp-reveal" href="{{ routes.all_products_collection_url }}?occasion=Occasion">
        <div class="lbp-tile__media lbp-mask">{% if img_occasion != blank %}<img src="{{ img_occasion | image_url: width: 900 }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
        <div class="lbp-tile__foot"><span class="lbp-tile__name">Special Occasions</span><span class="lbp-tile__arrow" aria-hidden="true">&rarr;</span></div>
      </a>
    </div>
  </div>
</section>

<section class="lbp-section--tight" style="padding-block:calc(var(--section-y) * 0.6)">
  <div class="lbp-container">
    <div class="lbp-sectionhead lbp-reveal">
      <div><span class="lbp-eyebrow">By age</span><h2 class="lbp-h2 lbp-sectionhead__title">Shop by age</h2></div>
    </div>
    <div class="lbp-ages lbp-reveal">
      <a class="lbp-age" href="{{ routes.all_products_collection_url }}?age=Newborn">Newborn &ndash; 2 years</a>
      <a class="lbp-age" href="{{ routes.all_products_collection_url }}?age=2-5">2 &ndash; 5 years</a>
      <a class="lbp-age" href="{{ routes.all_products_collection_url }}?age=5-8">5 &ndash; 8 years</a>
      <a class="lbp-age" href="{{ routes.all_products_collection_url }}?age=8plus">8 years +</a>
    </div>
  </div>
</section>

<section class="lbp-section lbp-section--sand" id="new">
  <div class="lbp-container">
    <div class="lbp-sectionhead lbp-reveal">
      <div>
        <span class="lbp-eyebrow">Just arrived</span>
        <h2 class="lbp-h2 lbp-sectionhead__title">New this week</h2>
      </div>
      <a class="lbp-sectionhead__link" href="{{ routes.all_products_collection_url }}?sort=new">All new in</a>
    </div>
    <div class="lbp-grid">
      {%- assign new_products = collections.all.products | sort: 'created_at' | reverse -%}
      {%- assign i = 0 -%}
      {%- for product in new_products limit: 8 -%}
        {%- assign d = i | modulo: 4 -%}
        {% render 'product-card', product: product, delay: d %}
        {%- assign i = i | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section>
  <div class="lbp-container">
    <div class="lbp-editorial">
      <figure class="lbp-editorial__figure lbp-mask lbp-reveal">
        <img src="{{ 'IMG_2664.jpg' | file_img_url: '1100x' }}" alt="Naxos Floral Smock Dress" loading="lazy" decoding="async">
      </figure>
      <div class="lbp-editorial__body lbp-reveal" data-delay="1">
        <span class="lbp-eyebrow">Our story</span>
        <h2 class="lbp-h2 lbp-editorial__title">A small shop with a long buying list.</h2>
        <p class="lbp-lead lbp-editorial__text">{{ shop.name }} is independently run from Spiddal, twelve miles along the coast road from Galway city. We buy traditional and Spanish childrenswear direct &mdash; Miranda, Rahigo, Sonata and more &mdash; alongside the shoes, boots and accessories that finish an outfit, and we design our own smock collection in-house. If you'd rather spread the cost of an occasion outfit, ask us about payment plans in the shop.</p>
        <a class="lbp-tlink" href="{{ pages['about-us'].url | default: '#' }}">Read our story <span class="lbp-tlink__arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </div>
</section>

<section class="lbp-section--sand" style="padding-block:var(--section-y)">
  <div class="lbp-container">
    <div class="lbp-reviews lbp-reveal">
      <span class="lbp-eyebrow">In their words</span>
      <h2 class="lbp-h2" style="margin-top:10px">Loved by families across Ireland</h2>
    </div>
    <div class="jdgm-carousel-wrapper" data-hide-title="true" data-mode="reviews" data-max-items="12"></div>
  </div>
</section>

<section class="lbp-section--tight" style="padding-block:calc(var(--section-y) * 0.6)">
  <div class="lbp-container">
    <div class="lbp-trust lbp-reveal">
      <div>
        <h3 class="lbp-trust__title">Payment plans</h3>
        <p class="lbp-trust__text">Spread the cost of an occasion outfit. Ask us in the shop or by email.</p>
      </div>
      <div>
        <h3 class="lbp-trust__title">14-day returns</h3>
        <p class="lbp-trust__text">Unworn, tags attached, odour free. Footwear returned in its original box.</p>
      </div>
      <div>
        <h3 class="lbp-trust__title">Worldwide shipping</h3>
        <p class="lbp-trust__text">Posted from Spiddal. Ireland, the UK and further afield.</p>
      </div>
      <div>
        <h3 class="lbp-trust__title">Talk to a person</h3>
        <p class="lbp-trust__text">Sizing between two labels is rarely the same. Ask before you order.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Main: Home", "settings": [] }
{% endschema %}
