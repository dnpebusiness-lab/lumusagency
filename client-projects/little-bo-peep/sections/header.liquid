<header class="lbp-header" id="header">
  <div class="lbp-headtop">
    <button class="lbp-iconbtn lbp-burger" type="button" aria-label="Open menu" data-open="mnav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a class="lbp-logo" href="{{ routes.root_url }}">{{ shop.name }}<span class="lbp-logo__sub">Spiddal &middot; Co Galway</span></a>
    <div class="lbp-header__tools">
      <button class="lbp-iconbtn" type="button" aria-label="Search" data-open="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      </button>
      <a class="lbp-iconbtn lbp-iconbtn--account" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="8" r="3.6"/><path d="M4.6 20a7.4 7.4 0 0 1 14.8 0"/></svg>
      </a>
      <button class="lbp-iconbtn" type="button" aria-label="Shopping bag" data-open="bag">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 7h14l1 13H4L5 7Z"/><path d="M8.5 7V5.6a3.5 3.5 0 0 1 7 0V7"/></svg>
        <span class="lbp-bagcount" data-bagcount>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
  <nav class="lbp-navrow" aria-label="Primary">
    <ul>
      <li><a href="{{ routes.all_products_collection_url }}?sort=new">New In</a></li>

      <li class="lbp-navrow__item" data-mega>
        <a class="lbp-navrow__trigger" href="{{ routes.all_products_collection_url }}?gender=Girls" aria-haspopup="true" aria-expanded="false">Girls</a>
        <div class="lbp-mega">
          <div class="lbp-container"><div class="lbp-mega__inner">
            <div class="lbp-mega__col">
              <h2 class="lbp-mega__title">Shop Girls</h2>
              <ul class="lbp-mega__list">
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;type=Dresses">Dresses</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;type=Sets">Sets</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;type=Knitwear">Knitwear</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;occasion=Occasion">Occasionwear</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;occasion=Christening">Christening</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;type=Shoes">Shoes</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Girls&amp;type=Accessories">Accessories</a></li>
              </ul>
            </div>
            <a class="lbp-mega__feature" href="{{ routes.all_products_collection_url }}?gender=Girls">
              <div class="lbp-mega__figure"><img src="{{ 'IMG_2664.jpg' | file_img_url: '900x' }}" alt="" loading="lazy"></div>
              <span class="lbp-eyebrow">Shop the edit</span>
              <p class="lbp-h4">All Girls</p>
            </a>
          </div></div>
        </div>
      </li>

      <li class="lbp-navrow__item" data-mega>
        <a class="lbp-navrow__trigger" href="{{ routes.all_products_collection_url }}?gender=Boys" aria-haspopup="true" aria-expanded="false">Boys</a>
        <div class="lbp-mega">
          <div class="lbp-container"><div class="lbp-mega__inner">
            <div class="lbp-mega__col">
              <h2 class="lbp-mega__title">Shop Boys</h2>
              <ul class="lbp-mega__list">
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;type=Sets">Sets</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;type=Shirts">Shirts</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;type=Knitwear">Knitwear</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;occasion=Occasion">Occasionwear</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;occasion=Christening">Christening</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;type=Shoes">Shoes</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Boys&amp;type=Accessories">Accessories</a></li>
              </ul>
            </div>
            <a class="lbp-mega__feature" href="{{ routes.all_products_collection_url }}?gender=Boys">
              <div class="lbp-mega__figure"><img src="{{ 'IMG_7637_4425dfda-c77a-4bb7-b79d-96761940b6c0.jpg' | file_img_url: '900x' }}" alt="" loading="lazy"></div>
              <span class="lbp-eyebrow">Shop the edit</span>
              <p class="lbp-h4">All Boys</p>
            </a>
          </div></div>
        </div>
      </li>

      <li class="lbp-navrow__item" data-mega>
        <a class="lbp-navrow__trigger" href="{{ routes.all_products_collection_url }}?gender=Baby" aria-haspopup="true" aria-expanded="false">Baby</a>
        <div class="lbp-mega">
          <div class="lbp-container"><div class="lbp-mega__inner">
            <div class="lbp-mega__col">
              <h2 class="lbp-mega__title">Shop Baby</h2>
              <ul class="lbp-mega__list">
                <li><a href="{{ routes.all_products_collection_url }}?gender=Baby,Girls">Baby Girls</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Baby,Boys">Baby Boys</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Baby&amp;type=Rompers">Rompers</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Baby&amp;type=Sets">Sets</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?gender=Baby&amp;type=Knitwear">Knitwear</a></li>
              </ul>
            </div>
            <a class="lbp-mega__feature" href="{{ routes.all_products_collection_url }}?gender=Baby">
              <div class="lbp-mega__figure"><img src="{{ 'IMG_1922.jpg' | file_img_url: '900x' }}" alt="" loading="lazy"></div>
              <span class="lbp-eyebrow">Shop the edit</span>
              <p class="lbp-h4">All Baby</p>
            </a>
          </div></div>
        </div>
      </li>

      <li class="lbp-navrow__item" data-mega>
        <a class="lbp-navrow__trigger lbp-navrow__lbp" href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep" aria-haspopup="true" aria-expanded="false">Little Bo Peep</a>
        <div class="lbp-mega">
          <div class="lbp-container"><div class="lbp-mega__inner">
            <div class="lbp-mega__col">
              <h2 class="lbp-mega__title">Our Signature Collection</h2>
              <ul class="lbp-mega__list">
                <li><a class="lbp-navrow__lbp" href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep">Signature Smock Collection</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep&amp;type=Dresses">Dresses</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep&amp;type=Rompers">Rompers</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep&amp;type=Pyjamas">Pyjamas</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep&amp;type=Swimwear">Swimwear</a></li>
              </ul>
            </div>
            <a class="lbp-mega__feature" href="{{ routes.all_products_collection_url }}?brand=Little+Bo+Peep">
              <div class="lbp-mega__figure"><img src="{{ '433d28f9-7742-46c2-aadf-e78e345c23da.jpg' | file_img_url: '900x' }}" alt="" loading="lazy"></div>
              <span class="lbp-eyebrow">Designed in Galway since 2017</span>
              <p class="lbp-h4">Discover the Collection</p>
            </a>
          </div></div>
        </div>
      </li>

      <li class="lbp-navrow__item" data-mega>
        <a class="lbp-navrow__trigger" href="{{ routes.all_products_collection_url }}?occasion=Occasion" aria-haspopup="true" aria-expanded="false">Occasion</a>
        <div class="lbp-mega">
          <div class="lbp-container"><div class="lbp-mega__inner">
            <div class="lbp-mega__col">
              <h2 class="lbp-mega__title">Shop Occasion</h2>
              <ul class="lbp-mega__list">
                <li><a href="{{ routes.all_products_collection_url }}?occasion=Christening">Christening</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?occasion=Communion">Communion</a></li>
                <li><a href="{{ routes.all_products_collection_url }}?occasion=Occasion">Special Occasions</a></li>
              </ul>
            </div>
            <a class="lbp-mega__feature" href="{{ routes.all_products_collection_url }}?occasion=Occasion">
              <div class="lbp-mega__figure"><img src="{{ 'IMG_2669.jpg' | file_img_url: '900x' }}" alt="" loading="lazy"></div>
              <span class="lbp-eyebrow">The day itself</span>
              <p class="lbp-h4">Shop Occasion</p>
            </a>
          </div></div>
        </div>
      </li>

      <li><a href="{{ routes.all_products_collection_url }}">Brands</a></li>
      <li><a href="{{ collections['summer-sale'].url | default: routes.all_products_collection_url }}">Sale</a></li>
    </ul>
  </nav>
</header>

<aside class="lbp-drawer" data-drawer="search" aria-label="Search" aria-hidden="true">
  <div class="lbp-drawer__head"><h2 class="lbp-drawer__title">Search</h2>
    <button class="lbp-iconbtn" type="button" aria-label="Close search" data-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="lbp-drawer__body">
    <form class="lbp-search" action="{{ routes.search_url }}" method="get" role="search">
      <input class="lbp-field" type="search" name="q" placeholder="Search products" value="{{ search.terms | escape }}" required autofocus>
      <input type="hidden" name="type" value="product">
      <button class="lbp-btn lbp-btn--solid lbp-btn--block" type="submit">Search</button>
    </form>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
