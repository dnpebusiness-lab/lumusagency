{% stylesheet %}
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md);
    background-color: white;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    transition: all var(--transition-medium);
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .header__nav {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .header__nav-item a {
    font-size: var(--font-size-body);
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .header__nav-item a:hover {
    color: var(--color-accent-coral);
  }

  .header__actions {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .header__search,
  .header__account,
  .header__cart {
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .header__search:hover,
  .header__account:hover,
  .header__cart:hover {
    color: var(--color-accent-coral);
  }

  .header__cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: var(--color-accent-coral);
    color: white;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .header__nav {
      display: none;
    }

    .header__logo {
      font-size: 20px;
    }
  }
{% endstylesheet %}

<header class="header">
  <a href="{{ routes.root_url }}" class="header__logo">
    Little Bo Peep
  </a>

  <nav class="header__nav" role="navigation" aria-label="Main navigation">
    <li class="header__nav-item">
      <a href="{{ collections.all.url }}">New In</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Girls</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Boys</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Baby</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Spanish Clothing</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Occasionwear</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Brands</a>
    </li>
    <li class="header__nav-item">
      <a href="#">Sale</a>
    </li>
  </nav>

  <div class="header__actions">
    <button class="header__search" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>

    <a href="{{ routes.account_url }}" class="header__account" aria-label="Account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </a>

    <button class="header__cart" aria-label="Cart" id="cart-toggle" style="position: relative;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      {% if cart.item_count > 0 %}
        <span class="header__cart-count">{{ cart.item_count }}</span>
      {% endif %}
    </button>
  </div>
</header>
